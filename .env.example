# Backend environment variables. Replace placeholders locally; never commit .env.
DB_URL=jdbc:mysql://mysql:3306/todo_db
DB_USERNAME=todo_user
DB_PASSWORD=replace_me
MYSQL_DATABASE=todo_db
MYSQL_ROOT_PASSWORD=replace_me
DOCKERHUB_USERNAME=local
IMAGE_TAG=local
COHERE_API_KEY=replace_me
SLACK_WEBHOOK_URL=replace_me
CORS_ALLOWED_ORIGINS=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me

# React reads this at build time.
REACT_APP_API_URL=
