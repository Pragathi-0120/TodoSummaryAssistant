# Backend environment variables. Replace placeholders locally; never commit .env.
DB_URL=jdbc:mysql://localhost:3306/todo_db?createDatabaseIfNotExist=true
DB_USERNAME=todo_user
DB_PASSWORD=replace_me
COHERE_API_KEY=replace_me
SLACK_WEBHOOK_URL=replace_me

# React reads this at build time.
REACT_APP_API_URL=http://localhost:8080
